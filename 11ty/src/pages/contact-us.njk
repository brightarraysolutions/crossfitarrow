<div class="col-md-6">
  <section class="py-5">
    <div class="container">
      <h2 class="text-center mb-4">📞 Contact Information</h2>
      <div class="row justify-content-center">
        <div class="col-md-8">
          <div class="card shadow-sm">
            <div class="card-body">
              <h4 class="card-title">{{ contact.Name }}</h4>

              <p class="mb-3">
                <strong>📍 Address:</strong><br>
                {{ contact.Address.StreetAddress }}<br>
                {{ contact.Address.City }}, {{ contact.Address.State }} {{ contact.Address.Zip }}<br>
                <a href="{{contact.Address.DirectionsLink}}" target="_blank">Get Directions</a>
              </p>

              <p class="mb-3">
                <strong>📞 Phone:</strong><br>
                <a href="tel:{{ contact.Phone | replace('(', '') | replace(')', '') | replace(' ', '') | replace('-', '') }}"
                  class="text-decoration-none">
                  {{ contact.Phone }}
                </a>
              </p>

              <p>
                <strong>✉️ Email:</strong><br>
                <a href="mailto:{{ contact.Email }}" class="text-decoration-none">
                  {{ contact.Email }}
                </a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
