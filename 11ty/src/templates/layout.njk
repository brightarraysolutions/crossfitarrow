<!DOCTYPE html>
<html lang="en" data-bs-theme="auto">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="">  
  <title>Cross Fit Arrow - {{ title }}</title> 
  <link rel="stylesheet" href="{% asset 'style.css' %}"/>   
</head>

<body>
  <header data-bs-theme="dark">
    <nav class="navbar navbar-expand-md navbar-dark fixed-top bg-dark">
      <div class="container-fluid">
        <a class="navbar-brand" href="#">Cross Fit Arrow > {{ title }}</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse"
          aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse flex-row-reverse" id="navbarCollapse">
          <ul class="navbar-nav  mb-2 mb-md-0">
            {% for item in collections.nav %}
              {% set isActive = item.url == page.url %}
              <li class="nav-item">
                <a class="nav-link {% if isActive %}active{% endif %}" href="{{ item.url }}">{{ item.data.title }}</a>
              </li>
            {% endfor %}
          </ul>
       
        </div>
      </div>
    </nav>
  </header>
  <main>
    <div class="container"> 
      <div class="row gx-5"> 
        {{ content | safe }} 
      </div>
    </div>
    <!-- FOOTER -->
    <footer class="container">
      <p class="float-end">
        <a href="#">Back to top</a>
      </p>
      <p>&copy; 2017–2025 Company, Inc. &middot;
        <a href="#">Privacy</a>
        &middot;
        <a href="#">Terms</a>
      </p>
    </footer>
  </main>
  <script type="module" src="{% asset 'script.js' %}"></script>
</body>

</html>